# Base API endpoint URL for backend requests
# In local development with Vite dev proxy enabled, keep as '/api/v1'
# In production or standalone deployments, set to full URL (e.g. 'http://localhost:3001/api/v1' or 'https://api.your-domain.com/api/v1')
VITE_API_URL=http://localhost:3001/api/v1
