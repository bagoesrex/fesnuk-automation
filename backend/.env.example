# ==============================================================================
# Backend Configuration
# ==============================================================================

# Port the Express API server listens on (default: 3001)
PORT=3001

# Application environment ('development' | 'production')
NODE_ENV=development

# SQLite database file path used by Prisma ORM
# Relative to backend/prisma/ or backend/
DATABASE_URL="file:./dev.db"

# Directory where authenticated browser storageState JSON files are stored
SESSIONS_DIR=./sessions

# Directory where uploaded post images are saved
UPLOADS_DIR=./uploads

# Directory where Winston audit & error log files are stored
LOGS_DIR=./logs

# Playwright browser mode ('true' for headless on VPS/production, 'false' for headed local debugging)
PLAYWRIGHT_HEADLESS=false

# Delay in milliseconds between Playwright actions for realistic pacing
BROWSER_SLOW_MO=50

# Allowed origin for Cross-Origin Resource Sharing (CORS)
# Supports comma-separated origins (e.g. http://localhost:5173,https://my-app.vercel.app)
CORS_ORIGIN=http://localhost:5173

# Master Admin Password for dashboard & API protection
# Leave blank for open/local dev, or set a strong password for VPS / public deployment
ADMIN_PASSWORD=

# Secret key used to sign and verify JWT authentication tokens
JWT_SECRET=change-this-to-a-secure-random-secret-key-32-chars
