generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Account {
  id          String   @id @default(cuid())
  name        String
  sessionPath String
  proxyUrl    String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  groups    Group[]
  posts     Post[]
  schedules Schedule[]
  postLogs  PostLog[]
}

model Group {
  id        String   @id @default(cuid())
  fbGroupId String
  name      String
  url       String
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  accountId String
  account   Account  @relation(fields: [accountId], references: [id], onDelete: Cascade)

  scheduleGroups ScheduleGroup[]
  postLogs       PostLog[]

  @@unique([accountId, fbGroupId])
  @@index([accountId])
}

model Post {
  id         String   @id @default(cuid())
  title      String
  content    String
  imagePaths String   @default("[]")
  isActive   Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  accountId String
  account   Account  @relation(fields: [accountId], references: [id], onDelete: Cascade)

  schedules Schedule[]
  postLogs  PostLog[]

  @@index([accountId])
}

model Schedule {
  id             String         @id @default(cuid())
  name           String
  cronExpression String
  delayMinSec    Int            @default(300)
  delayMaxSec    Int            @default(900)
  isActive       Boolean        @default(true)
  status         String         @default("IDLE")
  lastRunAt      DateTime?
  nextRunAt      DateTime?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  accountId String
  account   Account @relation(fields: [accountId], references: [id], onDelete: Cascade)

  postId String
  post   Post   @relation(fields: [postId], references: [id], onDelete: Cascade)

  scheduleGroups ScheduleGroup[]
  postLogs       PostLog[]

  @@index([accountId])
}

// ScheduleStatus: IDLE | RUNNING | PAUSED | ERROR
// LogStatus: SUCCESS | FAILED | SKIPPED
// SQLite does not support enums — values are enforced at the service layer

model ScheduleGroup {
  id    String @id @default(cuid())
  order Int    @default(0)

  scheduleId String
  schedule   Schedule @relation(fields: [scheduleId], references: [id], onDelete: Cascade)

  groupId String
  group   Group  @relation(fields: [groupId], references: [id], onDelete: Cascade)

  @@unique([scheduleId, groupId])
}

model PostLog {
  id       String    @id @default(cuid())
  status   String
  error    String?
  postedAt DateTime  @default(now())

  scheduleId String?
  schedule   Schedule? @relation(fields: [scheduleId], references: [id], onDelete: SetNull)

  groupId String?
  group   Group?  @relation(fields: [groupId], references: [id], onDelete: SetNull)

  postId String?
  post   Post?   @relation(fields: [postId], references: [id], onDelete: SetNull)

  accountId String?
  account   Account? @relation(fields: [accountId], references: [id], onDelete: SetNull)
}


